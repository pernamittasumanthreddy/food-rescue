# ============================================================
# FOODRESCUE ENTERPRISE CONFIGURATION (.env.example)
# ============================================================

# Environment
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173

# Primary Database (PostgreSQL)
DATABASE_URL=postgresql://foodrescue_admin:SecurePass123!@localhost:5432/foodrescue_db?schema=public
DB_MAX_CONNECTIONS=20
DB_TIMEOUT_MS=10000

# Redis (Caching, Queues & Sessions)
REDIS_URL=redis://:RedisSecure2026@localhost:6379/0
REDIS_TTL_SECONDS=3600

# Security & JWT Tokens
JWT_SECRET=super_secret_foodrescue_jwt_key_2026_enterprise
JWT_EXPIRATION=24h
JWT_REFRESH_SECRET=super_secret_foodrescue_refresh_jwt_key_2026_enterprise
JWT_REFRESH_EXPIRATION=7d
PASSWORD_SALT_ROUNDS=12
ENCRYPTION_KEY=32_character_aes_encryption_key_here!

# Indian FSSAI Compliance & Regulatory Settings
FSSAI_VERIFICATION_STRICT_MODE=true
MAX_DONATION_TEMP_CELSIUS=8.0
MIN_HOT_HOLD_TEMP_CELSIUS=65.0
DEFAULT_CURRENCY=INR
CURRENCY_SYMBOL=₹

# AI Matching Engine Tuning
MATCHING_WEIGHT_DISTANCE=0.35
MATCHING_WEIGHT_CAPACITY=0.25
MATCHING_WEIGHT_DIETARY=0.15
MATCHING_WEIGHT_URGENCY=0.15
MATCHING_WEIGHT_RELIABILITY=0.10
MAX_DISPATCH_RADIUS_KM=25

# Communications (Simulation / Indian SMS Providers)
SMS_PROVIDER=msg91_simulation
SMS_SENDER_ID=FDRSCU
EMAIL_FROM=alerts@foodrescue.org.in
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USER=apikey
EMAIL_PASS=your_sendgrid_api_key_here

# Geolocation & Mapping (Indian Grid)
DEFAULT_LATITUDE=16.5062
DEFAULT_LONGITUDE=80.6480
DEFAULT_REGION=Andhra Pradesh
DEFAULT_CITY=Vijayawada
